{
  "compilerOptions": {
    "target": "ES2021", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"], "strict": true, "noImplicitAny": true,
    "resolveJsonModule": true, "esModuleInterop": true, "skipLibCheck": true,
    "isolatedModules": true, "types": ["vitest/globals"]
  },
  "include": ["src", "tests"]
}
